[Unit]
Description=XR read-only KMS hardware WebRTC viewer
After=network.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/xr/debug:/opt/mix-remote-video/lib
Environment=GST_PLUGIN_PATH_1_0=/usr/lib/aarch64-linux-gnu/xr/debug/gstreamer-1.0:/opt/mix-remote-video/lib/gstreamer-1.0
KillMode=control-group
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
Environment=GST_REGISTRY=/run/mix-remote-video/gst-registry.bin
ExecStartPre=/usr/bin/rm -f /run/mix-remote-video/gst-registry.bin
ExecStart=/usr/bin/xr-debug-server --screen-service --listen 0.0.0.0 --port 8091 --token-file /var/lib/qiyu-debug/access.token --capture /usr/lib/aarch64-linux-gnu/xr/debug/video/nv12-capture-gpu
RuntimeDirectory=mix-remote-video mix-video-control
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
TimeoutStopSec=12
ProtectHome=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
