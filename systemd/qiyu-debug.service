[Unit]
Description=XR telemetry and shared camera tap console
After=network.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/xr/debug:/opt/mix-remote-video/lib
Environment=GST_PLUGIN_PATH_1_0=/usr/lib/aarch64-linux-gnu/xr/debug/gstreamer-1.0:/opt/mix-remote-video/lib/gstreamer-1.0
KillMode=control-group
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
Environment=GST_REGISTRY=/run/mix-camera-preview/gst-registry.bin
ExecStartPre=/usr/bin/rm -f /run/mix-camera-preview/frames.sock /run/mix-camera-preview/gst-registry.bin
ExecStart=/usr/bin/xr-debug-server --listen 0.0.0.0 --token-file /var/lib/qiyu-debug/access.token --session-file /run/mix-vr-shell-controller/session.json --capture /usr/lib/aarch64-linux-gnu/xr/debug/capture
RuntimeDirectory=mix-camera-preview mix-video-control
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
TimeoutStopSec=8
ProtectHome=read-only
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_ADMIN CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
